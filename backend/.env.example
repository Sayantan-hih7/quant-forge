NODE_ENV=development
HOST=127.0.0.1
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27019/quantforge_paper?replicaSet=quantforge&directConnection=true
REDIS_URL=redis://127.0.0.1:6381
ENGINE_URL=http://127.0.0.1:8100
ENGINE_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173
WORKSPACE_TOKEN=
# Configure using npm run configure:owner; required for hosted browser access.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
# The Docker image serves React and /api on the same origin.
FRONTEND_DIST=
# Additional full-day cash-market closures (ISO dates, comma-separated).
MARKET_HOLIDAYS=
# 2026 is included. Add a year only after loading its complete holiday list.
MARKET_CALENDAR_YEARS=
SECRET_ENCRYPTION_KEY=
MO_ENV=production
MO_CLIENT_CODE=
MO_PASSWORD=
MO_2FA=
MO_TOTP_SECRET=
MO_API_KEY=
MO_API_SECRET_KEY=
MO_DEVICE_MODEL=
MO_MANUFACTURER=
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional HTTPS endpoint for paper protection alerts (empty disables external delivery).
# Alerts also remain in MongoDB paper_protection_alerts; no trading credentials are sent.
PAPER_ALERT_WEBHOOK=
# AI provider selection (backend only). Existing Gemini configuration remains valid.
AI_PROVIDER=gemini
# Leave blank for GEMINI_MODEL. OpenAI/Anthropic require an explicit available model ID.
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
