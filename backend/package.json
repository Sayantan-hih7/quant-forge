{
  "name": "@quantforge/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "node --import tsx src/worker.ts",
    "dev:feed": "node --import tsx src/feed.ts",
    "dev:paper": "node --import tsx src/paper.ts",
    "worker": "node dist/worker.js",
    "feed": "node dist/feed.js",
    "paper": "node dist/paper.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "lint": "eslint src scripts test",
    "typecheck:watch": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "address": "^1.1.2",
    "axios": "^1.20.0",
    "bullmq": "^5.61.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "ip-to-location": "file:vendor/motilal-broadcast-sdk/compat/ip-to-location",
    "macaddress": "^0.5.3",
    "mongoose": "^9.10.2",
    "public-ip": "file:vendor/motilal-broadcast-sdk/compat/public-ip",
    "python-struct": "^1.1.3",
    "systeminformation": "^5.33.9",
    "uuid": "^11.1.1",
    "ws": "^7.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2"
  }
}
